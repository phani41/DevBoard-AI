# =============================================================================
# Copy this file to .env and fill in your values:
#   cp .env.example .env
# =============================================================================

# --- Database (Required) ---
# PostgreSQL connection string (local, Supabase, Render, etc.)
DATABASE_URL=postgresql://postgres:password@localhost:5432/devboard

# --- JWT Authentication ---
SECRET_KEY=super-secret-key-change-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# --- OpenRouter AI ---
OPENROUTER_API_KEY=your-openrouter-api-key-here
OPENROUTER_MODEL=openai/gpt-4o

# --- CORS ---
CORS_ORIGINS=http://localhost:3000

# --- Environment ---
# Set to "production" for deployment. Defaults to "development".
# Development automatically uses onboarding@resend.dev for email.
ENVIRONMENT=development

# --- Resend Email (for password reset emails) ---
# Get your API key at https://resend.com/api-keys
RESEND_API_KEY=re_xxxxxxxxxxxx

# Sender name shown in email recipients' inboxes
FROM_NAME=DevBoard AI

# Sender email address (only required in production):
#   - Leave empty in development — onboarding@resend.dev is used automatically
#   - Set to your verified domain in production, e.g. noreply@yourdomain.com
FROM_EMAIL=

# --- Frontend URL ---
# Used in password reset links sent via email
FRONTEND_URL=http://localhost:3000

# --- Password Reset ---
# How long (in minutes) before a reset token expires
RESET_TOKEN_EXPIRE_MINUTES=30
